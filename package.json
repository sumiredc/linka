{
  "name": "linka",
  "version": "0.0.0",
  "private": true,
  "description": "Clip what you read in Chrome into a local knowledge graph, then hand that context to your coding agent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "dev": "vite build --watch --mode dev-page",
    "build": "vite build",
    "build:dev": "vite build --mode dev-page",
    "seed": "node --import ./scripts/ts-resolve.mjs scripts/seed.ts",
    "store": "sh scripts/build-store.sh"
  },
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.2"
  },
  "volta": {
    "node": "26.13.1",
    "npm": "12.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@relate/relate-wasm": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-force-graph-2d": "1.29.2",
    "zod": "4.6.7"
  }
}
